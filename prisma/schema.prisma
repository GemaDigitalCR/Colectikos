generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String          @id @default(uuid())
  username               String          @unique
  email                  String          @unique
  passwordHash           String
  name                   String
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  companiaHabitual       String?
  estiloViaje            String?
  lugarFavorito          String?
  provinciaResidencia    String?
  rangoEdad              String?
  tipoLugarPreferido     String?
  genero                 String?
  onboardingCompleted    Boolean         @default(false)
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?
  isAdmin                Boolean         @default(false)
  termsAccepted          Boolean         @default(false)
  termsAcceptedAt        DateTime?
  termsVersion           String?
  playMode               String?
  level                  Int             @default(1)
  xp                     Int             @default(0)
  currentStreak          Int             @default(0)
  lastLoginDate          DateTime?
  longestStreak          Int             @default(0)
  avatarUrl              String?
  estampillasDisponibles Int             @default(3)
  ultimaFechaEstampillas DateTime        @default(now())
  fechaBonoTicket        DateTime?
  fechaDevolucionTicket  DateTime?
  bucketList             String[]        @default([])
  ratings                Rating[]
  actionLogs             UserActionLog[]
  progress               UserProgress[]
  tikolones              Int             @default(500)
  beach                  Beach?
}

model Lugar {
  id               String          @id @default(uuid())
  nombre           String          @unique
  nombre_en        String?
  categoria        CategoriaLugar
  descripcion      String
  descripcion_en   String?
  ubicacion        String
  imagenUrl        String?
  createdAt        DateTime        @default(now())
  authorName       String?
  authorSocialLink String?
  edition          String          @default("FOUNDER")
  isVisible        Boolean         @default(true)
  grupo_variante   String?
  latitude         Float?
  longitude        Float?
  ratings          Rating[]
  SponsorEnRuta    SponsorEnRuta[]
  userProgress     UserProgress[]
}

model UserProgress {
  id              String    @id @default(uuid())
  userId          String
  lugarId         String
  completado      Boolean   @default(false)
  fechaCompletado DateTime?
  notas           String?
  esPublico       Boolean   @default(false)
  lugar           Lugar     @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lugarId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  imageUrl  String?
  caption   String?
  createdAt DateTime @default(now())
  userId    String
}

model Rating {
  id        String   @id @default(cuid())
  userId    String
  placeId   String
  score     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lugar     Lugar    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, placeId])
}

model UserActionLog {
  id         String   @id @default(uuid())
  userId     String
  actionType String
  targetId   String
  xpAwarded  Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sponsor {
  id            String          @id
  nombre        String
  provincia     String
  categoria     String
  direccion     String
  telefono      String?
  email         String?
  descripcion   String
  imagenUrl     String
  imagenesExtra String[]
  latitude      Float
  longitude     Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  fotoExtra1    String?
  fotoExtra2    String?
  sitioWeb      String?
  alcanceNacional Boolean       @default(false)
  imagen1         String?
  imagen2         String?
  imagen3         String?
  SponsorEnRuta   SponsorEnRuta[]
}

model SponsorEnRuta {
  sponsorId String
  lugarId   String
  Lugar     Lugar   @relation(fields: [lugarId], references: [id], onDelete: Cascade)
  Sponsor   Sponsor @relation(fields: [sponsorId], references: [id], onDelete: Cascade)

  @@id([sponsorId, lugarId])
}

enum CategoriaLugar {
  PROVINCIA
  VOLCAN
  PARQUE_NACIONAL
  PLAYA
  RIOS_Y_CATARATAS
  LAGUNAS
  HITOS_CULTURALES
  BOSQUES_RESERVAS
  CIUDAD_Y_CULTURA
}

model Beach {
  id               String   @id @default(uuid())
  userId           String   @unique
  gridState        Json     @default("[]")
  visitors         Int      @default(0)
  lastUpdated      DateTime @default(now())
  xpClaimed        Int      @default(0)
  lifetimeVisitors Int      @default(0)
  lastDailyReward  DateTime?
  name             String?

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
